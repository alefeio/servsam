# Copie para .env.local. Não coloque segredo neste arquivo.

DATABASE_ENV=

# Runtime do Next.js. Conexão usada pelo Prisma Client.
RUNTIME_DATABASE_URL=

# Migrations e Prisma CLI. Conexão direta.
POSTGRES_URL=

# Presentes no provedor. O código da aplicação não lê estas duas.
DATABASE_URL=
PRISMA_DATABASE_URL=

# Sessão do Better Auth. Segredo longo, só no servidor.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# E-mail transacional (recuperação de senha). Só no servidor. Remetente de domínio verificado.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Bootstrap do primeiro usuário. Sem estes valores o seed cria a organização e os papéis, e não cria usuário.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Upload de imagens, só no servidor. Ainda sem fluxo de OS.
APIMG_API_KEY=
APIMG_UPLOAD_URL=
