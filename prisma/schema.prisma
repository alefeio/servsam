generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Organização única da V1. Não há UI de multiempresa.
model Organization {
  id                String             @id
  name              String
  slug              String             @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  users             User[]
  roles             Role[]
  auditLogs         AuditLog[]
  customers                Customer[]
  customerContacts         CustomerContact[]
  customerUnits            CustomerUnit[]
  proposals                Proposal[]
  proposalItems            ProposalItem[]
  documentSequences        DocumentSequence[]
  receivedPurchaseOrders   ReceivedPurchaseOrder[]
  receivedPurchaseOrderItems ReceivedPurchaseOrderItem[]
  engagements              Engagement[]
  engagementItems          EngagementItem[]
  serviceOrders            ServiceOrder[]
  employees                Employee[]
  serviceAppointments      ServiceAppointment[]

  @@map("organization")
}

/// Conta de acesso. Papéis ficam em UserRole, não num enum neste registro.
model User {
  id              String           @id
  name            String
  email           String
  emailVerified   Boolean          @default(false)
  image           String?
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  isActive        Boolean          @default(true)
  createdAt       DateTime
  updatedAt       DateTime
  sessions        Session[]
  accounts        Account[]
  userRoles       UserRole[]
  auditLogs       AuditLog[]       @relation("AuditActor")
  roleGrants      RolePermission[] @relation("PermissionGrantActor")
  roleAssignments UserRole[]       @relation("RoleAssignActor")

  @@unique([email])
  @@index([organizationId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model Role {
  id              String           @id
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  code            String
  name            String
  description     String
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("role")
}

model Permission {
  id              String           @id
  key             String           @unique
  description     String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permission")
}

model UserRole {
  id           String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt   DateTime @default(now())
  assignedById String?
  assignedBy   User?    @relation("RoleAssignActor", fields: [assignedById], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

model RolePermission {
  id           String     @id
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedAt    DateTime   @default(now())
  grantedById  String?
  grantedBy    User?      @relation("PermissionGrantActor", fields: [grantedById], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model AuditLog {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorUserId    String?
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id])
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

/// Sprint 11A. Cliente � o agregador de relacionamento. Exclus�o � l�gica (deletedAt).
model Customer {
  id             String            @id
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  legalName      String
  tradeName      String?
  /// CPF ou CNPJ, s� d�gitos. Opcional: prospect pode ainda n�o ter documento.
  document       String?
  segment        String?
  notes          String?
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  contacts               CustomerContact[]
  units                  CustomerUnit[]
  proposals              Proposal[]
  receivedPurchaseOrders ReceivedPurchaseOrder[]
  engagements            Engagement[]
  serviceOrders          ServiceOrder[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, document])
  /// Índice único parcial ativo: ver migration 20261118193000_customer_document_active_unique.
  @@map("customer")
}

model CustomerContact {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  name           String
  roleTitle      String?
  email          String?
  phone          String?
  isPrimary      Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, customerId])
  @@map("customer_contact")
}

model CustomerUnit {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  name           String
  addressLine    String?
  city           String?
  state          String?
  postalCode     String?
  notes          String?
  deletedAt              DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  proposals              Proposal[]
  receivedPurchaseOrders ReceivedPurchaseOrder[]
  engagements            Engagement[]
  serviceOrders          ServiceOrder[]

  @@index([organizationId, customerId])
  @@map("customer_unit")
}

/// Estados em docs/architecture/v1/state-machines.md. UI usa o r�tulo "Or�amento".
enum ProposalStatus {
  draft
  sent
  accepted
  rejected
  expired
}

model Proposal {
  id                   String         @id
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id])
  /// N�mero leg�vel por organiza��o e ano (ORC-2026-0001). Nunca reutilizado.
  code                 String
  customerId           String
  customer             Customer       @relation(fields: [customerId], references: [id])
  customerUnitId       String?
  customerUnit         CustomerUnit?  @relation(fields: [customerUnitId], references: [id])
  title                String
  status               ProposalStatus @default(draft)
  validUntil           DateTime?
  paymentTerms         String?
  commercialConditions String?
  observations         String?
  /// Valores monet�rios em centavos (inteiro). Total = soma dos itens - desconto.
  discountCents        Int            @default(0)
  totalCents           Int            @default(0)
  sentAt               DateTime?
  decidedAt            DateTime?
  rejectionReason      String?
  /// Proposta que esta substitui (ajuste de aceita/expirada gera outra proposta).
  supersedesId         String?
  supersedes           Proposal?      @relation("ProposalSuccession", fields: [supersedesId], references: [id])
  successors           Proposal[]     @relation("ProposalSuccession")
  createdById          String?
  updatedById          String?
  deletedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  items                ProposalItem[]
  engagement           Engagement?

  @@unique([organizationId, code])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, customerId])
  @@map("proposal")
}

model ProposalItem {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  proposalId     String
  proposal       Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  position       Int
  description    String
  quantity       Decimal      @db.Decimal(12, 3)
  unitPriceCents Int
  totalCents     Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, proposalId])
  @@map("proposal_item")
}

/// Contador at�mico de numera��o por organiza��o, chave e ano.
model DocumentSequence {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  year           Int
  lastValue      Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key, year])
  @@map("document_sequence")
}

/// Sprint 11B.1 — O.C. recebida do contratante (≠ orçamento SERVSAM ≠ OS).
enum ReceivedPurchaseOrderStatus {
  registered
  contracted
  cancelled
}

model ReceivedPurchaseOrder {
  id                String                      @id
  organizationId    String
  organization      Organization                @relation(fields: [organizationId], references: [id])
  /// Número interno SERVSAM (OC-2026-0001).
  code              String
  customerId        String
  customer          Customer                    @relation(fields: [customerId], references: [id])
  customerUnitId    String?
  customerUnit      CustomerUnit?               @relation(fields: [customerUnitId], references: [id])
  /// Número da O.C. no documento do cliente.
  externalNumber    String
  receivedAt        DateTime
  description       String
  observations      String?
  agreedAmountCents Int                         @default(0)
  /// Referência textual ao documento recebido (anexo completo na 11C).
  documentReference String?
  status            ReceivedPurchaseOrderStatus @default(registered)
  createdById       String?
  updatedById       String?
  deletedAt         DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  items             ReceivedPurchaseOrderItem[]
  engagement        Engagement?

  @@unique([organizationId, code])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, customerId])
  @@map("received_purchase_order")
}

model ReceivedPurchaseOrderItem {
  id              String                @id
  organizationId  String
  organization    Organization          @relation(fields: [organizationId], references: [id])
  purchaseOrderId String
  purchaseOrder   ReceivedPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  position        Int
  description     String
  quantity        Decimal               @db.Decimal(12, 3)
  unitPriceCents  Int
  totalCents      Int
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([organizationId, purchaseOrderId])
  @@map("received_purchase_order_item")
}

/// Sprint 11B.1 — Formalização comercial (Contratação). Origem: orçamento aceito ou O.C.
enum EngagementOrigin {
  proposal
  purchase_order
}

enum EngagementStatus {
  active
  cancelled
}

model Engagement {
  id              String                 @id
  organizationId  String
  organization    Organization           @relation(fields: [organizationId], references: [id])
  /// Número interno (CTR-2026-0001).
  code            String
  customerId      String
  customer        Customer               @relation(fields: [customerId], references: [id])
  customerUnitId  String?
  customerUnit    CustomerUnit?          @relation(fields: [customerUnitId], references: [id])
  origin          EngagementOrigin
  proposalId      String?                @unique
  proposal        Proposal?              @relation(fields: [proposalId], references: [id])
  purchaseOrderId String?                @unique
  purchaseOrder   ReceivedPurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  title           String
  status          EngagementStatus       @default(active)
  totalCents      Int                    @default(0)
  notes           String?
  createdById     String?
  updatedById     String?
  deletedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  items           EngagementItem[]
  serviceOrders   ServiceOrder[]

  @@unique([organizationId, code])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, customerId])
  @@map("engagement")
}

model EngagementItem {
  id             String         @id
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  engagementId   String
  engagement     Engagement     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  position       Int
  description    String
  quantity       Decimal        @db.Decimal(12, 3)
  unitPriceCents Int
  totalCents     Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  serviceOrders  ServiceOrder[]

  @@index([organizationId, engagementId])
  @@map("engagement_item")
}

/// Sprint 11B.2 — Ordem de Serviço persistente (execução vem em sprints posteriores).
enum ServiceOrderStatus {
  issued
  scheduled
  in_progress
  completed
  cancelled
}

model ServiceOrder {
  id               String             @id
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id])
  /// Número interno (OS-2026-0001).
  code             String
  engagementId     String
  engagement       Engagement         @relation(fields: [engagementId], references: [id])
  engagementItemId String
  engagementItem   EngagementItem     @relation(fields: [engagementItemId], references: [id])
  customerId       String
  customer         Customer           @relation(fields: [customerId], references: [id])
  customerUnitId   String?
  customerUnit     CustomerUnit?      @relation(fields: [customerUnitId], references: [id])
  description      String
  scopeNotes       String?
  observations     String?
  /// Referência à quantidade contratada (não vira número de visitas).
  quantity         Decimal            @db.Decimal(12, 3)
  status           ServiceOrderStatus @default(issued)
  issuedAt         DateTime
  issuedById       String?
  cancelledAt      DateTime?
  cancelledById    String?
  cancellationReason String?
  createdById      String?
  updatedById      String?
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  appointments     ServiceAppointment[]

  @@unique([organizationId, code])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, engagementId])
  @@index([organizationId, customerId])
  @@index([engagementItemId])
  @@map("service_order")
}

/// Sprint 11B.3 — Colaborador operacional (entidade de negócio; não é conta de login).
model Employee {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  fullName       String
  jobTitle       String
  isActive       Boolean      @default(true)
  phone          String?
  email          String?
  /// Vínculo opcional futuro com conta de acesso — não exige login no MVP.
  userId         String?
  notes          String?
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  appointments   ServiceAppointment[]

  @@index([organizationId, isActive, deletedAt])
  @@index([organizationId, fullName])
  @@map("employee")
}

/// Situação do compromisso operacional (não é execução técnica de campo).
enum ServiceAppointmentStatus {
  scheduled
  completed
  cancelled
}

/// Sprint 11B.3 — Agendamento vinculado a uma OS. Um vigente por OS nesta sprint.
model ServiceAppointment {
  id               String                   @id
  organizationId   String
  organization     Organization             @relation(fields: [organizationId], references: [id])
  serviceOrderId   String
  serviceOrder     ServiceOrder             @relation(fields: [serviceOrderId], references: [id])
  customerId       String
  customerUnitId   String?
  employeeId       String?
  employee         Employee?                @relation(fields: [employeeId], references: [id])
  startsAt         DateTime
  endsAt           DateTime
  status           ServiceAppointmentStatus @default(scheduled)
  notes            String?
  /// Motivo de remarcação ou cancelamento.
  changeReason     String?
  /// Se true, o usuário confirmou apesar de conflito de horário do colaborador.
  conflictAccepted Boolean                  @default(false)
  createdById      String?
  updatedById      String?
  cancelledAt      DateTime?
  cancelledById    String?
  deletedAt        DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([organizationId, startsAt, endsAt])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, employeeId, startsAt])
  @@index([serviceOrderId, status])
  @@index([organizationId, customerId])
  @@map("service_appointment")
}
